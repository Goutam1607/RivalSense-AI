# RivalSense — environment variables
# Copy this file to `.env` in the repo root (one file is shared by the web app, Prisma and the pipeline):
#   Copy-Item .env.example .env
# Never commit `.env`. Secrets are read only on the server.

# PostgreSQL connection. `npm run db:up` starts a local server that matches this URL
# (Docker if available, otherwise an embedded PostgreSQL in .data/postgres).
# For production use your managed Postgres URL (e.g. Neon) with ?sslmode=require.
DATABASE_URL="postgresql://rivalsense:rivalsense@localhost:5432/rivalsense"

# Better Auth: a long random secret used to sign session cookies (min 32 chars).
# Generate one in PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Public base URL of the web app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Demo login used by the "Explore demo" button (read-only demo workspace).
# `npm run seed` creates this user. Demo credentials: demo@rivalsense.dev / demo-password-123
DEMO_USER_EMAIL="demo@rivalsense.dev"
DEMO_USER_PASSWORD="demo-password-123"

# Optional: GitHub sign-in. Leave empty to hide it (the button shows as disabled with a reason).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional LLM rewording of insight text: none | anthropic | openai
# With "none" (default) every insight uses deterministic template text. The LLM never produces
# numbers: its output is rejected if it contains any number that is not in the computed facts.
LLM_PROVIDER="none"
# Optional model override (defaults: anthropic → claude-opus-5-5, openai → gpt-4.1-mini)
LLM_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
